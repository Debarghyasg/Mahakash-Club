    <style>
        /* Coordinators section fixes — scoped to this page only, style.css untouched */
        #Coordinators .coord-subheading {
            text-align: center;
            font-size: 2rem;
            font-weight: 300;
            letter-spacing: 4px;
            text-transform: uppercase;
            font-family: 'Arial', sans-serif;
            color: #ffffff;
            margin: 60px 0 30px;
            position: relative;
        }
        #Coordinators .team-subheading {
            text-align: center;
            font-size: 1.3rem;
            font-weight: 600;
            letter-spacing: 1px;
            font-family: 'Arial', sans-serif;
            color: #00d9ff;
            text-transform: uppercase;
            margin: 35px 0 15px;
        }
        #Coordinators .assi {
            margin-left: 0;
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 30px;
        }
        #Coordinators .card2 {
            margin-left: 0;
            margin-top: 0;
        }
        /* Row wrapper to place Tech Team and Photography side by side */
        #Coordinators .team-row {
            display: flex;
            justify-content: center;
            align-items: flex-start;
            gap: 60px;
            flex-wrap: wrap;
        }
        #Coordinators .team-row .team-subheading {
            margin: 35px 0 15px;
        }
    </style>

</head>
