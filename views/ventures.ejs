<script src="/app.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js" integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI" crossorigin="anonymous"></script>

<script>
    // Event details data — keep in sync with the cards above.
    const eventData = {
        weekly: {
            icon: "🔭",
            tag: "Weekly Events",
            title: "Club Sessions",
            desc: "Join us on our sessions where we learn different things about space exploration and astronomy.",
            images: ["s1.jpg", "s2.jpg", "s3.jpg"]
        },
        rocketry: {
            icon: "🚀",
            tag: "Previous Events",
            title: "Promotion of STEM and Water Rocketry Workshop",
            desc: "MAHAKASH GNIT × SPATZ IIT KGP — design, build, and launch your own model rockets! Our annual launch day brings together engineering and space exploration.",
            images: ["img1.jpg", "img2.jpg", "img3.jpg"]
        },
        duari: {
            icon: "🌌",
            tag: "Guest Lecture",
            title: "Guest Lecture by Dr. Debiprasad Duari",
            desc: "Ideas about black holes, wormholes and galaxies.",
            images: ["gs1.jpg"]
        },
        spatz: {
            icon: "🛰️",
            tag: "Guest Lecture",
            title: "Guest Lecture by Spatz Team, IIT KGP",
            desc: "Ideas about black holes, wormholes and galaxies.",
            images: ["gs2.jpg", "gs3.jpg"]
        },
        astro: {
            icon: "🌕",
            tag: "Past Event",
            title: "Astrophotography Event",
            desc: "Capturing the marvellous beauty of the pink moon.",
            images: ["moon2.jpg", "moon3.jpg"]
        },
        iirs: {
            icon: "🛰️",
            tag: "May 2026",
            title: "IIRS Course",
            desc: "A course with the Indian Institute of Remote Sensing (IIRS) on remote sensing and GIS applications.",
            // Add photo filenames here once available, e.g. "iirs1.jpg"
            images: []
        },
        spatz2026: {
            icon: "🚀",
            tag: "9th September 2026 · GNIT Auditorium & Field",
            title: "STAC 2026 — Space Technology Awareness Camp",
            desc: "Mahakash Club of GNIT in collaboration with spAtS, Kalpana Chawla Space Technology Cell, IIT Kharagpur presents\n\nSPACE TECHNOLOGY AWARENESS CAMP (STAC) 2026 🌌\n\nEver wanted to build a rocket, race a bot and test your space IQ - all in one day? This is it!\n\n📅 When: 9th September 2026\n📍 Where: GNIT Auditorium & Field\n\nWhat's in store for you?\n🚀 Pressure-fed Water Rocket Launch - Build & Fly!\n🤖 Line Follower Bot in Action\n🧠 Mind-blowing Space Quiz\n🛰️ Hands-on Exhibition & Workshop by IIT KGP Team",
            images: ["STAC261.JPG", "STAC262.JPG", "STAC263.JPG", "STAC264.JPG", "STAC265.JPG"]
        },
        chattopadhyay: {
            icon: "📡",
            tag: "2026",
            title: "Talk by Dr. Goutam Chattopadhyay",
            desc: "A talk by Dr. Goutam Chattopadhyay, NASA Jet Propulsion Laboratory.",
            // Add photo filenames here once available, e.g. "chattopadhyay1.jpg"
            images: []
        }
    };

    const overlay = document.getElementById("eventModalOverlay");
    const modalIcon = document.getElementById("modalIcon");
    const modalTitle = document.getElementById("modalTitle");
    const modalTag = document.getElementById("modalTag");
    const modalDesc = document.getElementById("modalDesc");
    const modalGallery = document.getElementById("modalGallery");
    const closeBtn = document.getElementById("eventModalClose");

    function openEventModal(id) {
        const data = eventData[id];
        if (!data) return;

        modalIcon.textContent = data.icon;
        modalTitle.textContent = data.title;
        modalTag.textContent = data.tag;
        modalDesc.textContent = data.desc;

        modalGallery.innerHTML = "";
        if (data.images.length === 0) {
            const placeholder = document.createElement("p");
            placeholder.className = "no-photos";
            placeholder.textContent = "Photos coming soon.";
            modalGallery.appendChild(placeholder);
        } else {
            data.images.forEach((src) => {
                const img = document.createElement("img");
                img.src = src;
                img.alt = data.title;
                modalGallery.appendChild(img);
            });
        }

        overlay.classList.add("active");
        document.body.classList.add("modal-open");
    }

    function closeEventModal() {
        overlay.classList.remove("active");
        document.body.classList.remove("modal-open");
    }

    document.querySelectorAll(".event-card").forEach((card) => {
        card.addEventListener("click", () => openEventModal(card.dataset.eventId));
        // keyboard accessibility
        card.setAttribute("tabindex", "0");
        card.setAttribute("role", "button");
        card.addEventListener("keydown", (e) => {
            if (e.key === "Enter" || e.key === " ") {
                e.preventDefault();
                openEventModal(card.dataset.eventId);
            }
        });
    });

    closeBtn.addEventListener("click", closeEventModal);
    overlay.addEventListener("click", (e) => {
        if (e.target === overlay) closeEventModal();
    });
    document.addEventListener("keydown", (e) => {
        if (e.key === "Escape") closeEventModal();
    });
</script>

</body>
</html>
