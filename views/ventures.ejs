<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Ventures</title>
    <link rel="icon" type="image/png" href="favicon.jpeg">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB" crossorigin="anonymous">
    <link rel="stylesheet" href="/style.css">

    <!--
        New styles for this page only: the auto-scrolling photo marquee
        and the click-to-expand event cards/modal. These are scoped to
        their own classes so nothing in style.css is overridden.
        Feel free to move this block into style.css later.
    -->
    <style>
        /* ---------- Photo Marquee (top, left-to-right auto scroll) ---------- */
        .marquee-section {
            width: 100%;
            padding: 140px 0 10px;
            position: relative;
            z-index: 1;
        }
        @media (max-width: 768px) {
            .marquee-section {
                /* extra top padding on mobile so content clears the fixed navbar
                   and, on notched devices, the safe-area top inset */
                padding-top: calc(130px + env(safe-area-inset-top, 0px));
            }
        }
        .marquee-title {
            text-align: center;
            margin-bottom: 18px;
            letter-spacing: 1px;
            opacity: 0.9;
        }
        .marquee-wrapper {
            overflow: hidden;
            width: 100%;
            position: relative;
            -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0%, #000 8%, #000 92%, transparent 100%);
        }
        .marquee-track {
            display: flex;
            gap: 22px;
            width: max-content;
            animation: marquee-ltr 32s linear infinite;
        }
        .marquee-wrapper:hover .marquee-track {
            animation-play-state: paused;
        }
        .marquee-track img {
            width: 210px;
            height: 145px;
            object-fit: cover;
            border-radius: 14px;
            box-shadow: 0 6px 22px rgba(0, 0, 0, 0.45);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: transform 0.35s ease, box-shadow 0.35s ease;
            flex-shrink: 0;
        }
        .marquee-track img:hover {
            transform: translateY(-6px) scale(1.06);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6);
        }
        @keyframes marquee-ltr {
            from { transform: translateX(-50%); }
            to   { transform: translateX(0); }
        }

        /* ---------- Section headings (Ongoing / 2026 / Past) ---------- */
        .events-section {
            margin-top: 46px;
        }
        .events-section:first-of-type {
            margin-top: 30px;
        }
        .section-heading {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 22px;
        }
        .section-heading h2 {
            font-size: 1.5rem;
            margin: 0;
            white-space: nowrap;
        }
        .section-heading .section-rule {
            height: 1px;
            flex: 1;
            background: linear-gradient(90deg, rgba(255,255,255,0.28), transparent);
        }

        /* ---------- Event Cards Grid ---------- */
        .events-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
            gap: 26px;
            margin-top: 20px;
        }
        /* Single-card sections (e.g. "Ongoing") get centered instead of
           stretching one card across the full grid width */
        .events-grid.single-card {
            display: flex;
            justify-content: center;
        }
        .events-grid.single-card .event-card {
            width: 100%;
            max-width: 360px;
        }
        .event-card {
            cursor: pointer;
            border-radius: 16px;
            padding: 26px 22px;
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.1);
            backdrop-filter: blur(6px);
            transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
            position: relative;
            overflow: hidden;
        }
        .event-card::after {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 30% 20%, rgba(255,255,255,0.08), transparent 60%);
            opacity: 0;
            transition: opacity 0.35s ease;
        }
        .event-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.5);
            border-color: rgba(255, 255, 255, 0.28);
        }
        .event-card:hover::after {
            opacity: 1;
        }
        .event-card .event-icon {
            font-size: 2.4rem;
            margin-bottom: 10px;
            display: inline-block;
            transition: transform 0.4s ease;
        }
        .event-card:hover .event-icon {
            transform: rotate(-8deg) scale(1.15);
        }
        .event-card .event-tag {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            opacity: 0.65;
            margin-bottom: 6px;
        }
        .event-card h3 {
            margin: 4px 0 10px;
        }
        .event-card .event-teaser {
            opacity: 0.85;
            font-size: 0.95rem;
            margin-bottom: 14px;
        }
        .event-card .click-hint {
            font-size: 0.82rem;
            opacity: 0.6;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: gap 0.3s ease, opacity 0.3s ease;
        }
        .event-card:hover .click-hint {
            opacity: 1;
            gap: 10px;
        }
        .event-card .mini-thumbs {
            display: flex;
            gap: 8px;
            margin-top: 14px;
        }
        .event-card .mini-thumbs img {
            width: 54px;
            height: 40px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.15);
            transition: transform 0.3s ease;
        }
        .event-card:hover .mini-thumbs img {
            transform: translateY(-3px);
        }

        /* ---------- Modal ---------- */
        .event-modal-overlay {
            position: fixed;
            inset: 0;
            background: rgba(4, 4, 12, 0.75);
            backdrop-filter: blur(4px);
            display: flex;
            align-items: center;
            justify-content: center;
            z-index: 1050;
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.35s ease, visibility 0.35s ease;
            padding: 20px;
        }
        .event-modal-overlay.active {
            opacity: 1;
            visibility: visible;
        }
        .event-modal {
            width: 100%;
            max-width: 720px;
            max-height: 85vh;
            overflow-y: auto;
            background: #0d0d1a;
            border: 1px solid rgba(255, 255, 255, 0.14);
            border-radius: 20px;
            padding: 34px 30px;
            position: relative;
            transform: scale(0.9) translateY(20px);
            opacity: 0;
            transition: transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.4s ease;
            box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
        }
        .event-modal-overlay.active .event-modal {
            transform: scale(1) translateY(0);
            opacity: 1;
        }
        .event-modal-close {
            position: absolute;
            top: 16px;
            right: 18px;
            background: rgba(255, 255, 255, 0.08);
            border: none;
            color: inherit;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            font-size: 1.3rem;
            line-height: 1;
            cursor: pointer;
            transition: background 0.3s ease, transform 0.3s ease;
        }
        .event-modal-close:hover {
            background: rgba(255, 255, 255, 0.2);
            transform: rotate(90deg);
        }
        .event-modal .modal-icon {
            font-size: 2.6rem;
        }
        .event-modal h2 {
            margin: 10px 0 4px;
        }
        .event-modal .modal-subtitle {
            opacity: 0.7;
            margin-bottom: 14px;
            font-size: 0.95rem;
        }
        .event-modal .modal-desc {
            opacity: 0.9;
            margin-bottom: 22px;
            line-height: 1.6;
            /* preserve the line breaks / bullet layout of the description text */
            white-space: pre-line;
        }
        .modal-gallery {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
            gap: 14px;
        }
        .modal-gallery img {
            width: 100%;
            height: 150px;
            object-fit: cover;
            border-radius: 12px;
            opacity: 0;
            transform: translateY(14px);
            animation: fade-in-up 0.5s ease forwards;
            border: 1px solid rgba(255, 255, 255, 0.1);
            transition: transform 0.3s ease;
        }
        .modal-gallery img:hover {
            transform: scale(1.04);
        }
        .modal-gallery .no-photos {
            opacity: 0.6;
            font-style: italic;
            font-size: 0.9rem;
        }
        .modal-gallery img:nth-child(1) { animation-delay: 0.05s; }
        .modal-gallery img:nth-child(2) { animation-delay: 0.15s; }
        .modal-gallery img:nth-child(3) { animation-delay: 0.25s; }
        @keyframes fade-in-up {
            to { opacity: 1; transform: translateY(0); }
        }

        body.modal-open {
            overflow: hidden;
        }
    </style>
</head>
<body>

